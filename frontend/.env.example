# Base URL of the FlashReserve backend API.
#
# VITE_* variables are exposed to the browser.
# NEVER put secrets here - JWT secrets, database/Redis/Razorpay credentials
# must only ever live in backend server-side configuration.
#
# Leave EMPTY in development: the Vite dev server proxies same-origin
# /api requests to the backend (see vite.config.js), so no CORS setup
# is needed. In production, set this to the API's public origin.
VITE_API_BASE_URL=
